{
  "name": "backoffice-turismo-backend",
  "version": "1.0.0",
  "description": "Backend API para backoffice de turismo",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "node -e \"const fs=require('fs');if(fs.existsSync('.eslintrc.json')||fs.existsSync('.eslintrc.js')||fs.existsSync('eslint.config.js')||fs.existsSync('.eslintrc')){require('child_process').spawnSync('eslint',['src','--ext','.ts'],{stdio:'inherit'})}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["turismo", "backoffice", "api"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@backoffice-guide/shared": "file:../shared",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@supabase/supabase-js": "^2.39.0",
    "express-validator": "^7.0.1",
    "pg": "^8.11.3",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/cors": "^2.8.17",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}

